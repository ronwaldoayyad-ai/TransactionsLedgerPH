# Browser build inputs: public values only.
VITE_APP_ENV=production
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLIC_KEY=PUBLIC_KEY
VITE_MOBILE_BORROWER=true
VITE_HOSTED_SERVICES_ENABLED=true
VITE_RELEASE_ACCESS_ENABLED=true
VITE_ALLOW_DEMO=false
# Server runtime: inject through hosting secrets, never VITE_ variables.
APP_ORIGIN=https://PREVIEW_OR_PRODUCTION_HOST
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLIC_KEY=PUBLIC_KEY
SUPABASE_SERVICE_KEY=SERVER_ONLY_KEY
# Session pooler port 5432 or direct TLS. Transaction pooler 6543 is unsupported.
DATABASE_URL=postgresql://USER:PASSWORD@SESSION_POOL_HOST:5432/postgres
# Paste the Supabase database root CA certificate as a server-only multiline value.
DATABASE_CA_CERT=SUPABASE_DATABASE_ROOT_CA_CERTIFICATE
LOGIN_CODE_SECRET=REPLACE_WITH_DEDICATED_RANDOM_32_PLUS_CHARACTER_SECRET
NOTIFICATION_WORKER_SECRET=REPLACE_WITH_SEPARATE_RANDOM_32_PLUS_CHARACTER_SECRET
