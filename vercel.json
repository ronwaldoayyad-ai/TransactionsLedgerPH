{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "regions": ["sin1"],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "support.ronwaldo.com" }], "destination": "https://loanledgerph.ronwaldo.com/:path*", "permanent": false },
    { "source": "/:path*", "has": [{ "type": "host", "value": "transactions-ledger-ph.vercel.app" }], "destination": "https://loanledgerph.ronwaldo.com/:path*", "permanent": false },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.loanledgerph.ronwaldo.com" }], "destination": "https://loanledgerph.ronwaldo.com/:path*", "permanent": false },
    { "source": "/:path*", "has": [{ "type": "host", "value": "transactions-ledger-ph-ronwaldoayyad-ais-projects.vercel.app" }], "destination": "https://loanledgerph.ronwaldo.com/:path*", "permanent": false },
    { "source": "/:path*", "has": [{ "type": "host", "value": "transactions-ledger-ph-git-main-ronwaldoayyad-ais-projects.vercel.app" }], "destination": "https://loanledgerph.ronwaldo.com/:path*", "permanent": false }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "{server/**,public/notification-rule-core.js,public/faq-knowledge.json,public/locales/filipino-content.json,node_modules/@img/**,node_modules/@napi-rs/image*/**}" }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__route=:path*" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
